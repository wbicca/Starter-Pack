# Dependencies
node_modules/
.pnpm-store/

# Environment files — never commit real secrets
.env
.env.*
!.env.example
!.env.local.example
!.env.template

# Build output
dist/
build/
.next/
out/
coverage/

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Caches
.cache/
.turbo/
.eslintcache
*.tsbuildinfo

# codegraph local index (optional MCP — generated per project, never commit)
.codegraph/

# Temp files
*.tmp
*.temp
*~

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Local-only Claude/BMAD config (keep the rest vendored)
.claude/settings.local.json
_bmad/custom/config.user.toml

# BMAD output: ephemeral artifacts — keep only the base structure
/_bmad-output/**
!/_bmad-output/planning-artifacts/
!/_bmad-output/planning-artifacts/.gitkeep
!/_bmad-output/implementation-artifacts/
!/_bmad-output/implementation-artifacts/.gitkeep

# Kept vendored on purpose: _bmad, .claude/skills, .claude/agents, .claude/hooks, docs
